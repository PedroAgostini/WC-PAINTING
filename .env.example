# Estimate form — Web3Forms.
# Free access key at https://web3forms.com — paste it here and the form posts
# straight to the company inbox. Without it the form falls back to opening the
# visitor's mail app, pre-filled.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Search indexing. Leave unset on staging and preview builds: a Vercel
# production deployment on a .vercel.app address is crawled like any other
# site, and an indexed demo competes with the real domain later.
# Set to true only when the final domain is the one being served.
NEXT_PUBLIC_INDEXABLE=

# Canonical origin. Set to the final domain once it is live; otherwise the
# value in lib/site.config.ts is used.
NEXT_PUBLIC_SITE_URL=
